{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "pip install -r backend/requirements.txt && npm install",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ]
}
